#pragma once

#include <benchmarksuite-incl/config.hpp>

namespace benchmarksuite {

	struct gpu_properties {
		static constexpr uint64_t arg_alignment{ 16ULL };
		static constexpr uint64_t flops{ @BNCH_SWT_FP32_THROUGHPUT_BYTES@ULL };
		static constexpr uint64_t memory_bw{ @BNCH_SWT_MEMORY_BANDWIDTH_BYTES@ULL };
		static constexpr uint64_t alignment{ @BNCH_SWT_GPU_ALIGNMENT@ULL };
		static constexpr uint64_t sm_count{ @BNCH_SWT_SM_COUNT@ULL };
		static constexpr uint64_t max_threads_per_sm{ @BNCH_SWT_MAX_THREADS_PER_SM@ULL };
		static constexpr uint64_t max_threads_per_block{ @BNCH_SWT_MAX_THREADS_PER_BLOCK@ULL };
		static constexpr uint64_t warp_size{ @BNCH_SWT_WARP_SIZE@ULL };
		static constexpr uint64_t l2_cache_size{ @BNCH_SWT_GPU_L2_CACHE_SIZE@ULL };
		static constexpr uint64_t max_persisting_l2_bytes{ @BNCH_SWT_MAX_PERSISTING_L2_BYTES@ULL };
		static constexpr uint64_t shared_mem_per_sm{ @BNCH_SWT_SHARED_MEM_PER_BLOCK@ULL };
		static constexpr uint64_t max_grid_size_x{ @BNCH_SWT_MAX_GRID_SIZE_X@ULL };
		static constexpr uint64_t max_grid_size_y{ @BNCH_SWT_MAX_GRID_SIZE_Y@ULL };
		static constexpr uint64_t max_grid_size_z{ @BNCH_SWT_MAX_GRID_SIZE_Z@ULL };
		static constexpr uint64_t gpu_arch_index{ @BNCH_SWT_GPU_ARCH_INDEX@ULL };
		static constexpr uint64_t total_threads{ @BNCH_SWT_TOTAL_THREADS@ULL };
	};
}
