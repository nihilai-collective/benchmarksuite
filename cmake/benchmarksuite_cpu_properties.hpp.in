#pragma once

#include <benchmarksuite-incl/config.hpp>

namespace benchmarksuite {

	struct cpu_properties {
		static constexpr uint64_t thread_count{ @BNCH_SWT_THREAD_COUNT@ULL };
		static constexpr uint64_t l1_cache_size{ @BNCH_SWT_CPU_L1_CACHE_SIZE@ULL };
		static constexpr uint64_t l2_cache_size{ @BNCH_SWT_CPU_L2_CACHE_SIZE@ULL };
		static constexpr uint64_t l3_cache_size{ @BNCH_SWT_CPU_L3_CACHE_SIZE@ULL };
		static constexpr uint64_t cpu_arch_index{ @BNCH_SWT_CPU_ARCH_INDEX@ULL };
		static constexpr uint64_t cpu_alignment{ @BNCH_SWT_CPU_ALIGNMENT@ULL };
	};

}